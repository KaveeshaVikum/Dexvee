diff --git a/netlify/functions/submit-review.js b/netlify/functions/submit-review.js
new file mode 100644
index 0000000..f901235
--- /dev/null
+++ b/netlify/functions/submit-review.js
@@ -0,0 +1,179 @@
+import { initializeApp, cert, getApps } from 'firebase-admin/app';
+import { getFirestore, FieldValue } from 'firebase-admin/firestore';
+import { getAuth } from 'firebase-admin/auth';
+
+if (!getApps().length) {
+  initializeApp({
+    credential: cert({
+      projectId: process.env.FIREBASE_PROJECT_ID,
+      clientEmail: process.env.FIREBASE_CLIENT_EMAIL,
+      privateKey: process.env.FIREBASE_PRIVATE_KEY
+        ? process.env.FIREBASE_PRIVATE_KEY.replace(/\\n/g, '\n')
+        : undefined
+    })
+  });
+}
+
+const db = getFirestore();
+
+class RequestError extends Error {
+  constructor(statusCode, message) {
+    super(message);
+    this.statusCode = statusCode;
+  }
+}
+
+function jsonResponse(statusCode, body) {
+  return {
+    statusCode,
+    headers: { 'Content-Type': 'application/json' },
+    body: JSON.stringify(body)
+  };
+}
+
+function getBearerToken(headers = {}) {
+  const authorization = headers.authorization || headers.Authorization || '';
+  const match = /^Bearer\s+([^\s]+)$/i.exec(authorization);
+  return match?.[1] || null;
+}
+
+function parseBody(body) {
+  try {
+    return JSON.parse(body || '{}');
+  } catch {
+    throw new RequestError(400, 'Invalid request body.');
+  }
+}
+
+function getAuthorName(decoded) {
+  const displayName = typeof decoded.name === 'string'
+    ? decoded.name
+    : typeof decoded.displayName === 'string'
+      ? decoded.displayName
+      : '';
+  const cleaned = displayName.replace(/[\u0000-\u001f\u007f]/g, '').trim().slice(0, 120);
+  return cleaned || 'Verified customer';
+}
+
+export const handler = async (event) => {
+  if (event.httpMethod !== 'POST') {
+    return jsonResponse(405, { success: false, error: 'Method Not Allowed' });
+  }
+
+  try {
+    const token = getBearerToken(event.headers);
+    if (!token) throw new RequestError(401, 'A valid Firebase ID token is required.');
+
+    let decoded;
+    try {
+      decoded = await getAuth().verifyIdToken(token);
+    } catch {
+      throw new RequestError(401, 'A valid Firebase ID token is required.');
+    }
+
+    const { orderId, productId, rating, text } = parseBody(event.body);
+    if (typeof orderId !== 'string' || !orderId.trim() || orderId.length > 1500 || orderId.includes('/')) {
+      throw new RequestError(400, 'A valid orderId is required.');
+    }
+    if (typeof productId !== 'string' || !productId.trim() || productId.length > 1500 || productId.includes('/')) {
+      throw new RequestError(400, 'A valid productId is required.');
+    }
+    if (!Number.isInteger(rating) || rating < 1 || rating > 5) {
+      throw new RequestError(400, 'Rating must be an integer from 1 to 5.');
+    }
+    if (typeof text !== 'string' || text.trim().length < 5 || text.trim().length > 1500) {
+      throw new RequestError(400, 'Review text must contain between 5 and 1500 characters.');
+    }
+
+    const normalizedOrderId = orderId.trim();
+    const normalizedProductId = productId.trim();
+    const reviewId = `${normalizedOrderId}_${normalizedProductId}`;
+    if (Buffer.byteLength(reviewId, 'utf8') > 1500) {
+      throw new RequestError(400, 'The order and product identifiers are too long.');
+    }
+
+    const orderRef = db.collection('orders').doc(normalizedOrderId);
+    const productRef = db.collection('products').doc(normalizedProductId);
+    const reviewRef = db.collection('productReviews').doc(reviewId);
+    const authorName = getAuthorName(decoded);
+    const reviewText = text.trim();
+
+    await db.runTransaction(async (transaction) => {
+      const [orderSnapshot, productSnapshot, reviewSnapshot] = await Promise.all([
+        transaction.get(orderRef),
+        transaction.get(productRef),
+        transaction.get(reviewRef)
+      ]);
+
+      if (!orderSnapshot.exists) throw new RequestError(404, 'Order not found.');
+      const order = orderSnapshot.data() || {};
+      if (order.userId !== decoded.uid) throw new RequestError(403, 'You are not authorized to review this order.');
+
+      const status = String(order.status || '').trim().toLowerCase();
+      if (!['delivered', 'complete', 'completed'].includes(status)) {
+        throw new RequestError(409, 'Reviews can only be submitted for delivered orders.');
+      }
+      const items = Array.isArray(order.items) ? order.items : [];
+      const hasPurchasedProduct = items.some((item) =>
+        (typeof item?.id === 'string' && item.id === normalizedProductId)
+        || (typeof item?.productId === 'string' && item.productId === normalizedProductId)
+      );
+      if (!hasPurchasedProduct) {
+        throw new RequestError(403, 'This product is not part of the specified order.');
+      }
+      if (!productSnapshot.exists) throw new RequestError(404, 'Product not found.');
+      if (reviewSnapshot.exists) throw new RequestError(409, 'A review has already been submitted for this product and order.');
+
+      const uniqueOrderProductIds = [...new Set(items.flatMap((item) => {
+        const id = typeof item?.id === 'string' ? item.id : item?.productId;
+        return typeof id === 'string' && id ? [id] : [];
+      }))];
+      const reviewedProductIds = new Set(
+        Array.isArray(order.reviewedProductIds)
+          ? order.reviewedProductIds.filter((id) => typeof id === 'string')
+          : []
+      );
+      reviewedProductIds.add(normalizedProductId);
+      const allProductsReviewed = uniqueOrderProductIds.length > 0
+        && uniqueOrderProductIds.every((id) => reviewedProductIds.has(id));
+
+      const product = productSnapshot.data() || {};
+      const currentCount = Number.isInteger(product.reviewsCount) && product.reviewsCount >= 0
+        ? product.reviewsCount
+        : 0;
+      const currentRating = Number.isFinite(Number(product.rating))
+        ? Number(product.rating)
+        : 0;
+      const nextCount = currentCount + 1;
+      const nextRating = Math.round((((currentCount * currentRating) + rating) / nextCount) * 100) / 100;
+
+      transaction.create(reviewRef, {
+        productId: normalizedProductId,
+        orderId: normalizedOrderId,
+        userId: decoded.uid,
+        rating,
+        text: reviewText,
+        authorName,
+        verifiedPurchase: true,
+        createdAt: FieldValue.serverTimestamp()
+      });
+      transaction.update(productRef, {
+        rating: nextRating,
+        reviewsCount: nextCount
+      });
+      transaction.update(orderRef, {
+        reviewedProductIds: [...reviewedProductIds],
+        reviewSubmittedAt: allProductsReviewed ? FieldValue.serverTimestamp() : FieldValue.delete()
+      });
+    });
+
+    return jsonResponse(200, { success: true, reviewId });
+  } catch (error) {
+    const statusCode = error instanceof RequestError ? error.statusCode : 500;
+    if (statusCode >= 500) console.error('Review submission failed:', error?.message || 'unknown error');
+    return jsonResponse(statusCode, {
+      success: false,
+      error: error instanceof RequestError ? error.message : 'Unable to submit the review right now.'
+    });
+  }
+};
diff --git a/netlify/functions/update-order-status.js b/netlify/functions/update-order-status.js
new file mode 100644
index 0000000..c4fe0e1
--- /dev/null
+++ b/netlify/functions/update-order-status.js
@@ -0,0 +1,212 @@
+import { cert, getApps, initializeApp } from 'firebase-admin/app';
+import { FieldValue, getFirestore } from 'firebase-admin/firestore';
+import { authorizeAdmin } from './utils/admin-auth.js';
+
+if (!getApps().length) {
+  initializeApp({
+    credential: cert({
+      projectId: process.env.FIREBASE_PROJECT_ID,
+      clientEmail: process.env.FIREBASE_CLIENT_EMAIL,
+      privateKey: process.env.FIREBASE_PRIVATE_KEY
+        ? process.env.FIREBASE_PRIVATE_KEY.replace(/\\n/g, '\n')
+        : undefined
+    })
+  });
+}
+
+const db = getFirestore();
+const ORDER_STATUSES = new Set([
+  'placed',
+  'processing',
+  'shipped',
+  'in_transit',
+  'out_for_delivery',
+  'delivered',
+  'cancelled'
+]);
+const REQUEST_DECISIONS = new Set([
+  'cancel_approved',
+  'cancel_rejected',
+  'return_approved',
+  'return_rejected'
+]);
+const CONTROL_CHARACTERS = /[\u0000-\u001F\u007F]/;
+
+class RequestError extends Error {
+  constructor(statusCode, message) {
+    super(message);
+    this.statusCode = statusCode;
+  }
+}
+
+function jsonResponse(statusCode, body) {
+  return {
+    statusCode,
+    headers: { 'Content-Type': 'application/json' },
+    body: JSON.stringify(body)
+  };
+}
+
+function parseBody(event) {
+  try {
+    const raw = event.isBase64Encoded
+      ? Buffer.from(event.body || '', 'base64').toString('utf8')
+      : (event.body || '{}');
+    const body = JSON.parse(raw);
+    if (!body || typeof body !== 'object' || Array.isArray(body)) throw new Error('invalid');
+    return body;
+  } catch {
+    throw new RequestError(400, 'Invalid request body.');
+  }
+}
+
+function cleanOptionalText(value, field, maxLength, pattern) {
+  if (value === undefined) return undefined;
+  if (typeof value !== 'string') throw new RequestError(400, `Invalid ${field}.`);
+  const cleaned = value.trim();
+  if (cleaned.length > maxLength || CONTROL_CHARACTERS.test(cleaned) || /[<>]/.test(cleaned)) {
+    throw new RequestError(400, `Invalid ${field}.`);
+  }
+  if (cleaned && pattern && !pattern.test(cleaned)) {
+    throw new RequestError(400, `Invalid ${field}.`);
+  }
+  return cleaned;
+}
+
+function validateTrackingUrl(value) {
+  const cleaned = cleanOptionalText(value, 'tracking URL', 2048);
+  if (cleaned === undefined || cleaned === '') return cleaned;
+  try {
+    const url = new URL(cleaned);
+    if (url.protocol !== 'https:' || !url.hostname || url.username || url.password) {
+      throw new Error('invalid URL');
+    }
+  } catch {
+    throw new RequestError(400, 'Tracking URL must be a valid HTTPS URL.');
+  }
+  return cleaned;
+}
+
+function validateInput(body) {
+  const orderId = typeof body.orderId === 'string' ? body.orderId.trim() : '';
+  if (!orderId || orderId.length > 1500 || orderId.includes('/')) {
+    throw new RequestError(400, 'A valid orderId is required.');
+  }
+
+  if (typeof body.status !== 'string' || !ORDER_STATUSES.has(body.status)) {
+    throw new RequestError(400, 'A permitted order status is required.');
+  }
+
+  const trackingNumber = cleanOptionalText(
+    body.trackingNumber,
+    'tracking number',
+    120,
+    /^[\p{L}\p{N}][\p{L}\p{N} ._/#-]*$/u
+  );
+  const trackingUrl = validateTrackingUrl(body.trackingUrl);
+  const estimatedDelivery = cleanOptionalText(
+    body.estimatedDelivery,
+    'estimated delivery',
+    100,
+    /^[\p{L}\p{N}][\p{L}\p{N} .,()/–—-]*$/u
+  );
+  const adminNote = cleanOptionalText(body.adminNote, 'admin note', 500);
+
+  let requestStatus = body.requestStatus;
+  if (requestStatus === undefined || requestStatus === null) requestStatus = '';
+  if (typeof requestStatus !== 'string') throw new RequestError(400, 'Invalid request decision.');
+  requestStatus = requestStatus.trim();
+  if (requestStatus && !REQUEST_DECISIONS.has(requestStatus)) {
+    throw new RequestError(400, 'Invalid request decision.');
+  }
+
+  return {
+    orderId,
+    status: body.status,
+    trackingNumber,
+    trackingUrl,
+    estimatedDelivery,
+    adminNote,
+    requestStatus
+  };
+}
+
+export const handler = async (event) => {
+  if (event.httpMethod !== 'POST') {
+    return jsonResponse(405, { success: false, error: 'Method Not Allowed' });
+  }
+
+  const result = await authorizeAdmin(event);
+  if (!result.ok) return result.response;
+
+  try {
+    const input = validateInput(parseBody(event));
+    const orderRef = db.collection('orders').doc(input.orderId);
+    const updated = await db.runTransaction(async (transaction) => {
+      const snapshot = await transaction.get(orderRef);
+      if (!snapshot.exists) throw new RequestError(404, 'Order not found.');
+
+      const order = snapshot.data() || {};
+      const currentStatus = String(order.status || '').trim();
+      const changes = { updatedAt: FieldValue.serverTimestamp() };
+
+      if (input.trackingNumber !== undefined) changes.trackingNumber = input.trackingNumber;
+      if (input.trackingUrl !== undefined) changes.trackingUrl = input.trackingUrl;
+      if (input.estimatedDelivery !== undefined) changes.estimatedDelivery = input.estimatedDelivery;
+
+      if (input.requestStatus) {
+        const isCancelDecision = input.requestStatus.startsWith('cancel_');
+        const expectedRequestStatus = isCancelDecision ? 'cancel_requested' : 'return_requested';
+        const expectedAction = isCancelDecision ? 'cancel' : 'return';
+        const customerRequest = order.customerRequest || {};
+
+        if (order.customerRequestStatus !== expectedRequestStatus || customerRequest.action !== expectedAction) {
+          throw new RequestError(409, 'This decision does not match the current customer request.');
+        }
+
+        // A request decision is not a shipment-status edit. Only an approved,
+        // still-cancellable request may move an order to cancelled.
+        if (input.requestStatus === 'cancel_approved') {
+          if (!['placed', 'processing', 'ready_to_ship'].includes(currentStatus)) {
+            throw new RequestError(409, 'This order has progressed too far for cancellation approval.');
+          }
+          if (input.status !== currentStatus && input.status !== 'cancelled') {
+            throw new RequestError(409, 'Save shipment status changes separately from a request decision.');
+          }
+          changes.status = 'cancelled';
+        } else {
+          if (input.status !== currentStatus) {
+            throw new RequestError(409, 'Save shipment status changes separately from a request decision.');
+          }
+          if (!isCancelDecision && currentStatus !== 'delivered') {
+            throw new RequestError(409, 'A return decision requires a delivered order.');
+          }
+        }
+
+        changes.customerRequestStatus = input.requestStatus;
+        changes.adminNote = input.adminNote ?? '';
+      } else {
+        changes.status = input.status;
+        if (input.adminNote !== undefined) changes.adminNote = input.adminNote;
+        if (input.status === 'delivered' && currentStatus !== 'delivered') {
+          changes.deliveredAt = FieldValue.serverTimestamp();
+        }
+      }
+
+      transaction.update(orderRef, changes);
+      return {
+        status: changes.status || currentStatus,
+        customerRequestStatus: changes.customerRequestStatus || order.customerRequestStatus || null
+      };
+    });
+
+    return jsonResponse(200, { success: true, ...updated });
+  } catch (error) {
+    const statusCode = error instanceof RequestError ? error.statusCode : 500;
+    if (statusCode >= 500) console.error('Admin order update failed:', error?.message || 'unknown error');
+    return jsonResponse(statusCode, {
+      success: false,
+      error: error instanceof RequestError ? error.message : 'Unable to update the order right now.'
+    });
+  }
+};
diff --git a/netlify/functions/utils/admin-auth.js b/netlify/functions/utils/admin-auth.js
new file mode 100644
index 0000000..9bd5351
--- /dev/null
+++ b/netlify/functions/utils/admin-auth.js
@@ -0,0 +1,65 @@
+import { cert, getApps, initializeApp } from 'firebase-admin/app';
+import { getAuth } from 'firebase-admin/auth';
+
+function getFirebaseAdminApp() {
+  const existingApp = getApps().find((app) => app.name === '[DEFAULT]');
+  if (existingApp) return existingApp;
+
+  return initializeApp({
+    credential: cert({
+      projectId: process.env.FIREBASE_PROJECT_ID,
+      clientEmail: process.env.FIREBASE_CLIENT_EMAIL,
+      privateKey: process.env.FIREBASE_PRIVATE_KEY
+        ? process.env.FIREBASE_PRIVATE_KEY.replace(/\\n/g, '\n')
+        : undefined
+    })
+  });
+}
+
+function authFailure(statusCode, message) {
+  return {
+    ok: false,
+    response: {
+      statusCode,
+      body: JSON.stringify({ success: false, error: message })
+    }
+  };
+}
+
+export async function authorizeAdmin(event) {
+  const allowedEmails = (process.env.ADMIN_EMAILS || '')
+    .split(',')
+    .map((email) => email.trim().toLowerCase())
+    .filter(Boolean);
+
+  if (allowedEmails.length === 0) {
+    return authFailure(503, 'Admin access is not configured.');
+  }
+
+  const headers = event.headers || {};
+  const authorization = Object.entries(headers)
+    .find(([name]) => name.toLowerCase() === 'authorization')?.[1] || '';
+  const bearerMatch = typeof authorization === 'string'
+    ? authorization.match(/^Bearer\s+(\S+)\s*$/i)
+    : null;
+  if (!bearerMatch) {
+    return authFailure(401, 'Not authorized.');
+  }
+
+  let decodedToken;
+  try {
+    decodedToken = await getAuth(getFirebaseAdminApp()).verifyIdToken(bearerMatch[1]);
+  } catch {
+    return authFailure(401, 'Not authorized.');
+  }
+
+  if (decodedToken.email_verified !== true || typeof decodedToken.email !== 'string') {
+    return authFailure(403, 'Forbidden.');
+  }
+
+  if (!allowedEmails.includes(decodedToken.email.trim().toLowerCase())) {
+    return authFailure(403, 'Forbidden.');
+  }
+
+  return { ok: true, email: decodedToken.email };
+}
