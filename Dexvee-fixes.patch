       throw new Error('Order has no items.');
@@ -154,6 +204,20 @@ export const handler = async (event) => {
     if (paymentMethod === 'BANK_TRANSFER' && !receiptImageBase64) {
       throw new Error('A payment receipt is required for bank transfer orders.');
